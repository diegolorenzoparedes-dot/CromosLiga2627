let qty={}; let activeTab='all';
const $=id=>document.getElementById(id);
const norm=s=>(s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/s+/g,' ').trim();
const compact=s=>norm(s).replace(/[s.-]+/g,'');
function loadQty(){try{qty=JSON.parse(localStorage.getItem('liga2627_qty')||'{}')||{};}catch(e){qty={};}}
function saveQty(){localStorage.setItem('liga2627_qty',JSON.stringify(qty));}
function getQty(id){return Math.max(0,parseInt(qty[id]||0,10)||0);}
function setQty(id,n){n=Math.max(0,n|0);if(n===0)delete qty[id];else qty[id]=n;saveQty();renderStats();renderTeamGrid();renderList();}
function changeQty(id,d){setQty(id,getQty(id)+d);}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function metaFor(section){return teamMeta[section]||{abbr:section.slice(0,3).toUpperCase(),c1:'#475467',c2:'#98a2b3'};}
