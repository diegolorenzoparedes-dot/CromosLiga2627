'stripes-v';case 'Atlético de Madrid':return 'stripes-v';case 'FC Barcelona':return 'stripes-v';case 'Real Betis':return 'stripes-v';case 'RC Celta':return 'solid';case 'Deportivo La Coruña':return 'stripes-h';case 'Elche CF':return 'solid';case 'RCD Espanyol':return 'stripes-v';case 'Getafe CF':return 'halves-v';case 'Levante UD':return 'stripes-v';case 'Real Madrid CF':return 'ring';case 'Málaga CF':return 'stripes-v';case 'C.A. Osasuna':return 'halves-v';case 'Racing de Santander':return 'stripes-v';case 'Rayo Vallecano':return 'diagonal';case 'Real Sociedad':return 'stripes-v';case 'Sevilla FC':return 'stripes-v';case 'Valencia CF':return 'halves-v';case 'Villarreal CF':return 'solid';case 'ADN / LaLiga Prime':return 'diamond';case 'LaLiga Fantasy':return 'star';case 'Draft 23':return 'star';case 'Últimos Fichajes':return 'diagonal';case 'Top Fichajes':return 'star';case 'Draft 23 Kromix':return 'diamond';case 'Extra Sticker - Bronce':case 'Extra Sticker - Plata':case 'Extra Sticker - Oro':return 'ring';default:return 'solid';}}
function textColor(hex){const h=(hex||'#777').replace('#','');const r=parseInt(h.slice(0,2),16)||0,g=parseInt(h.slice(2,4),16)||0,b=parseInt(h.slice(4,6),16)||0;return ((r*299+g*587+b*114)/1000)>=150?'#111827':'#ffffff';}
function crestMarkup(m,section){const p=patternFor(section), t=textColor(m.c2||m.c1); let body=''; if(p==='stripes-v'){body=`<rect width="56" height="64" fill="${m.c2}"/><rect x="0" width="11" height="64" fill="${m.c1}"/><rect x="22" width="12" height="64" fill="${m.c1}"/><rect x="45" width="11" height="64" fill="${m.c1}"/>`;} else if(p==='stripes-h'){body=`<rect width="56" height="64" fill="${m.c2}"/><rect y="0" width="56" height="12" fill="${m.c1}"/><rect y="26" width="56" height="12" fill="${m.c1}"/><rect y="52" width="56" height="12" fill="${m.c1}"/>`;} else if(p==='diagonal'){body=`<rect width="56" height="64" fill="${m.c2}"/><polygon points="-8,56 12,64 64,8 44,0" fill="${m.c1}"/>`; } else if(p==='halves-v'){body=`<rect width="28" height="64" fill="${m.c1}"/><rect x="28" width="28" height="64" fill="${m.c2}"/>`; } else if(p==='diamond'){body=`<rect width="56" height="64" fill="${m.c1}"/><polygon points="28,10 46,28 28,46 10,28" fill="${m.c2}" opacity=".9"/>`; } else if(p==='star'){body=`<rect width="56" height="64" fill="${m.c1}"/><circle cx="28" cy="28" r="16" fill="${m.c2}" opacity=".9"/><polygon points="28,14 31.8,23 42,23.5 34,29.8 36.8,39.6 28,34 19.2,39.6 22,29.8 14,23.5 24.2,23" fill="${textColor(m.c2)}"/>`; } else if(p==='ring'){body=`<rect width="56" height="64" fill="${m.c2}"/><circle cx="28" cy="26" r="17" fill="none" stroke="${m.c1}" stroke-width="6"/><circle cx="28" cy="26" r="7" fill="${m.c1}" opacity=".85"/>`; } else {body=`<rect width="56" height="64" fill="${m.c1}"/>`; } const outline='<path d="M28 1 L54 8 L54 39 C54 50 43 57 28 63 C13 57 2 50 2 39 L2 8 Z" fill="none" stroke="rgba(255,255,255,.92)" stroke-width="2"/>'; const label=`<text x="28" y="53" text-anchor="middle" font-size="11" font-weight="900" fill="${t}" font-family="system-ui,Segoe UI,Arial,sans-serif">${(m.abbr||'').slice(0,3)}</text>`; return `<div class="crestWrap"><svg viewBox="0 0 56 64" aria-hidden="true"><defs><clipPath id="cp-${m.abbr}"><path d="M28 1 L54 8 L54 39 C54 50 43 57 28 63 C13 57 2 50 2 39 L2 8 Z"/></clipPath></defs><g clip-path="url(#cp-${m.abbr})">${body}</g>${outline}${label}</svg></div>`;}
function playerInitials(name){if(!name||name==='Pendiente')return '?';const parts=name.replace(/[()]/g,' ').split(/\s+/).filter(Boolean);if(parts.length===1)return parts[0].slice(0,2).toUpperCase();return (parts[0][0]+parts[parts.length-1][0]).toUpperCase();}
function avatarMarkup(s,m){if(s.name==='Escudo')return crestMarkup(m,s.section).replace('crestWrap','crestWrap thumbCrest'); const initials=playerInitials(s.name); const coach=(String(s.number)==='2'&&s.type==='equipo'); const extra=s.type!=='equipo'; const bg1=extra?m.c2:m.c1, bg2=extra?m.c1:m.c2; return `<svg viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="av-${compact(s.id)}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${bg1}"/><stop offset="1" stop-color="${bg2}"/></linearGradient></defs><rect width="64" height="64" rx="32" fill="url(#av-${compact(s.id)})"/><circle cx="32" cy="23" r="11" fill="rgba(255,255,255,.82)"/><path d="M13 57c2-13 10-20 19-20s17 7 19 20" fill="rgba(255,255,255,.82)"/>${coach?'<path d="M14 49h36v10H14z" fill="rgba(17,24,39,.55)"/>':''}<circle cx="49" cy="14" r="10" fill="rgba(0,0,0,.45)"/><text x="49" y="18" text-anchor="middle" font-size="10" font-weight="900" fill="#fff">${extra?'★':coach?'DT':'⚽'}</text><text x="32" y="55" text-anchor="middle" font-size="11" font-weight="900" fill="#111827">${initials}</text></svg>`;}
function baseTeamSections(){return sectionOrder.filter(sec=>stickers.some(s=>s.section===sec&&s.type==='equipo'));}
function renderTeamGrid(){const el=$('teamGrid'); if(!el)return; let out=''; for(const section of baseTeamSections()){const list=stickers.filter(s=>s.section===section), owned=list.filter(s=>getQty(s.id)>0).length, missing=list.length-owned, pct=list.length?Math.round(owned*100/list.length):0, m=metaFor(section); out+=`<article class="teamCard" style="--c1:${m.c1};--c2:${m.c2}"><div class="teamCardTop"><div class="teamMiniCrest">${crestMarkup(m,section)}</div><div style="min-width:0;flex:1"><div class="teamName">${esc(section)}</div><div class="teamProgressText">${owned}/${list.length} · ${pct}% · ${missing} faltan</div><div class="teamBar"><i style="width:${pct}%"></i></div></div></div><div class="teamCardActions"><button data-team-open="${esc(section)}">Ver equipo</button><button class="missingBtn" data-team-missing="${esc(section)}">Faltan (${missing})</button></div></article>`;} el.innerHTML=out; document.querySelectorAll('[data-team-open]').forEach(b=>b.onclick=()=>openTeam(b.dataset.teamOpen,false)); document.querySelectorAll('[data-team-missing]').forEach(b=>b.onclick=()=>openTeam(b.dataset.teamMissing,true));}
function openTeam(section,missingOnly){$('sectionFilter').value=section; $('typeFilter').value='equipo'; $('search').value=''; activeTab=missingOnly?'missing':'all'; document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('active',x.dataset.tab===activeTab)); renderList(); setTimeout(()=>{document.querySelector('.tabs').scrollIntoView({behavior:'smooth',block:'start'});},50);}
function renderStats(){const total=stickers.length, owned=stickers.filter(s=>getQty(s.id)>0).length, missing=total-owned, duplicates=stickers.reduce((a,s)=>a+Math.max(0,getQty(s.id)-1),0), copies=stickers.reduce((a,s)=>a+getQty(s.id),0), p=total?Math.round(owned*100/total):0; $('ownedCount').textContent=owned; $('totalCount').textContent=total; $('missingCount').textContent=missing; $('dupCount').textContent=duplicates; $('copiesCount').textContent=copies; $('percent').textContent=p+'%'; $('progressBar').style.width=p+'%';}
function filtered(){const q=norm($('search').value), sec=$('sectionFilter').value, type=$('typeFilter').value; return stickers.filter(s=>{const n=getQty(s.id); if(sec&&s.section!==sec)return false; if(type&&s.type!==type)return false; if(activeTab==='missing'&&n!==0)return false; if(activeTab==='dups'&&n<2)return false; if(activeTab==='owned'&&n<1)return false; if(q&&!norm(`${s.id} ${s.name} ${s.section} ${s.type}`).includes(q))return false; return true;});}
function renderList(){const items=filtered(); const groups=new Map(); for(const sec of sectionOrder) groups.set(sec,[]); items.forEach(s=>groups.get(s.section).push(s)); let html=''; for(const [section,list] of groups){ if(!list.length) continue; const m=metaFor(section), owned=list.filter(s=>getQty(s.id)>0).length; html+=`<section class="section"><div class="sectionHeader" style="--c1:${m.c1};--c2:${m.c2}">${crestMarkup(m,section)}<div class="sectionTitleWrap"><h2>${esc(section)}</h2><div class="subhead">${list.length} cromos en esta sección</div></div><span class="badge">${owned}/${list.length}</span></div><div class="sectionBody">`; for(const s of list){ const n=getQty(s.id), cls=(n>=2?'duplicate ':n===1?'owned ':'') + ((s.name||'').toLowerCase().includes('pendiente')?'pending':''); const status=n===0?'Falta':n===1?'En colección':`${n-1} repetido${n>2?'s':''}`; html+=`<div class="sticker ${cls}" style="--team:${m.c1};--teamText:${m.c1}"><div class="thumb">${avatarMarkup(s,m)}</div><div class="code">${esc(s.id)}</div><div class="info"><div class="name">${esc(s.name||'Pendiente')}</div><div class="sub">${esc(status)} · ${esc(s.type)}</div></div><div class="stepper"><button data-id="${esc(s.id)}" data-d="-1" aria-label="Restar">−</button><span class="qty">${n}</span><button class="plus" data-id="${esc(s.id)}" data-d="1" aria-label="Sumar">+</button></div></div>`; } html+='</div></section>'; } $('list').innerHTML=html; $('empty').classList.toggle('hidden',items.length>0); document.querySelectorAll('.stepper button').forEach(b=>b.addEventListener('click',()=>changeQty(b.dataset.id,parseInt(b.dataset.d,10))));}
function buildSections(){ $('sectionFilter').innerHTML='<option value="">Todas las secciones</option>'+sectionOrder.map(s=>`<option>${esc(s)}</option>`).join(''); }
function toast(msg){const el=$('toast'); el.textContent=msg; el.classList.add('show'); clearTimeout(window._toast); window._toast=setTimeout(()=>el.classList.remove('show'),1800);}
function quickAdd(){const raw=$('quickInput').value.trim(); if(!raw) return; const parts=raw.split(/[\n,;]+/).map(x=>x.trim()).filter(Boolean); let added=0, not=[]; for(const part of parts){const key=compact(part); let s=stickers.find(x=>compact(x.id)===key); if(!s){const hits=stickers.filter(x=>compact(x.name)===key); if(hits.length===1) s=hits[0];} if(s){qty[s.id]=getQty(s.id)+1; added++;} else not.push(part);} saveQty(); $('quickInput').value=''; renderStats(); renderTeamGrid(); renderList(); if(not.length) toast(`${added} añadidos · No encontrados: ${not.join(', ')}`); else toast(`${added} cromo${added===1?'':'s'} añadido${added===1?'':'s'}`);}
function share(text){if(window.Android&&Android.share)Android.share(text); else if(navigator.share)navigator.share({text}); else toast('La función compartir requiere Android.');}
function listText(mode){let arr=stickers.filter(s=>mode==='missing'?getQty(s.id)===0:getQty(s.id)>=2); const title=mode==='missing'?'FALTANTES':'REPETIDOS'; let out=`Cromos Liga 2026-27 · ${title}
`; let sec=''; for(const s of arr){ if(s.section!==sec){ sec=s.section; out+=`
${sec}
`; } out+=mode==='missing'?`${s.id} · ${s.name}
`:`${s.id} · ${s.name} · x${getQty(s.id)-1}
`; } return out.trim(); }
function csvText(mode){const rows=[['codigo','numero','nombre','seccion','tipo','cantidad']]; for(const s of stickers){const n=getQty(s.id); if(mode==='missing'&&n!==0) continue; if(mode==='dups'&&n<2) continue; rows.push([s.id,s.number,s.name,s.section,s.type,mode==='dups'?String(n-1):String(n)]);} return rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\n');}
function shareCsv(mode){const title=mode==='missing'?'faltantes':'repetidos'; share(`CSV ${title}\n`+csvText(mode));}function backupText(){return JSON.stringify({app:'Cromos Liga 2026-27',version:3,date:new Date().toISOString(),quantities:qty});}
function applyBackup(){try{const obj=JSON.parse($('backupText').value); if(!obj||typeof obj.quantities!=='object') throw new Error(); qty={}; for(const [k,v] of Object.entries(obj.quantities)){ if(stickers.some(s=>s.id===k)&&Number(v)>0) qty[k]=Math.max(0,parseInt(v,10)||0); } saveQty(); $('backupModal').classList.add('hidden'); $('backupText').value=''; renderStats(); renderTeamGrid(); renderList(); toast('Copia importada');}catch(e){toast('Copia no válida');}}
function initEvents(){ $('quickAdd').onclick=quickAdd; $('quickInput').addEventListener('keydown',e=>{if(e.key==='Enter')quickAdd();}); $('search').addEventListener('input',renderList); $('sectionFilter').addEventListener('change',renderList); $('typeFilter').addEventListener('change',renderList); $('toggleTeams').onclick=()=>{const g=$('teamGrid'); const hidden=g.classList.toggle('hiddenGrid'); $('toggleTeams').textContent=hidden?'Mostrar':'Ocultar';}; document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{ activeTab=b.dataset.tab; document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('active',x===b)); renderList(); }); $('moreBtn').onclick=()=>$('menu').classList.remove('hidden'); $('closeMenu').onclick=()=>$('menu').classList.add('hidden'); $('menu').addEventListener('click',e=>{if(e.target===$('menu'))$('menu').classList.add('hidden');}); $('shareMissing').onclick=()=>share(listText('missing')); $('shareDups').onclick=()=>share(listText('dups')); $('exportMissingCsv').onclick=()=>shareCsv('missing'); $('exportDupsCsv').onclick=()=>shareCsv('dups'); $('shareBackup').onclick=()=>share(backupText()); $('importBackup').onclick=()=>{$('menu').classList.add('hidden');$('backupModal').classList.remove('hidden');}; $('cancelBackup').onclick=()=>$('backupModal').classList.add('hidden'); $('applyBackup').onclick=applyBackup; $('resetAll').onclick=()=>{if(confirm('¿Seguro que quieres borrar todo lo marcado?')){qty={}; saveQty(); $('menu').classList.add('hidden'); renderStats(); renderTeamGrid(); renderList(); toast('Colección puesta a cero');}}; }
loadQty(); buildSections(); initEvents(); renderStats(); renderTeamGrid(); renderList();
</script>
</body></html>