<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0b1220"><title>Cromos Liga 26-27</title>
<style>
:root{--bg:#f4f6f8;--card:#fff;--ink:#101828;--muted:#667085;--line:#e4e7ec;--green:#166534;--green2:#22c55e;--red:#b42318;--nav:#0b1220;--amber:#b54708;--shadow:0 8px 24px rgba(16,24,40,.08);--radius:18px}
*{box-sizing:border-box}html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}body{min-height:100vh;padding-bottom:36px}
.hero{background:linear-gradient(145deg,#0b1220,#183128);color:#fff;padding:calc(18px + env(safe-area-inset-top)) 18px 20px;border-radius:0 0 26px 26px;box-shadow:var(--shadow)}
.brandRow{display:flex;align-items:center;gap:12px}.ball{width:46px;height:46px;border-radius:15px;background:#fff;color:#111;display:grid;place-items:center;font-size:26px}.eyebrow{font-size:11px;letter-spacing:1.5px;opacity:.72;font-weight:800}.brandRow h1{font-size:24px;line-height:1;margin:4px 0 0}.iconBtn{margin-left:auto;border:0;background:rgba(255,255,255,.12);color:#fff;width:42px;height:42px;border-radius:14px;font-size:27px}
.progressWrap{margin-top:22px}.progressText{display:flex;align-items:baseline;gap:4px;font-size:14px}.progressText strong{font-size:28px}.progressText #percent{margin-left:auto;font-size:22px;font-weight:900}.progress{height:9px;background:rgba(255,255,255,.18);border-radius:999px;overflow:hidden;margin-top:9px}.progress>div{height:100%;width:0;background:linear-gradient(90deg,#86efac,#22c55e);border-radius:999px;transition:width .25s}.miniStats{display:flex;gap:15px;margin-top:10px;font-size:12px;opacity:.92;flex-wrap:wrap}.miniStats b{font-size:15px}
main{padding:16px;max-width:920px;margin:auto}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.quick{padding:15px}.quick label{display:block;font-weight:850;margin-bottom:9px}.quickRow{display:flex;gap:8px}.quickRow input,.search,select,textarea{border:1px solid #d0d5dd;background:#fff;color:var(--ink);border-radius:12px;font-size:16px;padding:12px;outline:none}.quickRow input:focus,.search:focus,select:focus,textarea:focus{border-color:#16a34a;box-shadow:0 0 0 3px rgba(34,197,94,.12)}.quickRow input{min-width:0;flex:1}.primary{background:var(--green);color:white;border:0;border-radius:12px;padding:0 17px;font-weight:800}.hint{font-size:12px;color:var(--muted);margin-top:8px;line-height:1.35}.toolbar{display:grid;grid-template-columns:1fr;gap:8px;margin:15px 0 10px}.search,select{width:100%}.thumb{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-size:22px;border:1px solid var(--line);background:linear-gradient(135deg,color-mix(in srgb,var(--team,#ddd) 12%, white),#fff)}
.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;background:#e9eef1;padding:5px;border-radius:14px;position:sticky;top:6px;z-index:5}.tabs button{border:0;background:transparent;padding:10px 4px;border-radius:10px;color:#475467;font-weight:800;font-size:13px}.tabs button.active{background:#fff;color:var(--green);box-shadow:0 2px 7px rgba(16,24,40,.09)}
.section{margin-top:18px}.sectionHeader{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:16px 16px 0 0;color:#fff;background:linear-gradient(135deg,var(--c1,#475467),var(--c2,#98a2b3));box-shadow:var(--shadow)}
.sectionTitleWrap{min-width:0;flex:1}.sectionHeader h2{font-size:17px;margin:0;line-height:1.15}.sectionHeader .subhead{opacity:.88;font-size:11px;margin-top:4px;letter-spacing:.3px}
.shield{width:42px;height:48px;display:grid;place-items:center;font-size:11px;font-weight:900;color:#fff;background:rgba(255,255,255,.18);clip-path:polygon(50% 0,100% 12%,100% 62%,50% 100%,0 62%,0 12%);border:1px solid rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.5px;padding:2px;text-align:center}.crestWrap{width:44px;height:50px;display:grid;place-items:center;flex:0 0 auto}.crestWrap svg{display:block;width:44px;height:50px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.18))}
.badge{font-size:11px;font-weight:800;color:#475467;background:#eaecf0;padding:5px 8px;border-radius:999px;white-space:nowrap}.sectionHeader .badge{background:rgba(255,255,255,.18);color:#fff}
.sectionBody{border:1px solid var(--line);border-top:0;border-radius:0 0 16px 16px;overflow:hidden}
.sticker{display:grid;grid-template-columns:68px 1fr auto;align-items:center;gap:11px;background:var(--card);border-bottom:1px solid var(--line);padding:10px 11px}.sticker:last-child{border-bottom:0}
.code{height:42px;display:grid;place-items:center;text-align:center;border-radius:11px;background:color-mix(in srgb,var(--team,#22c55e) 15%, white);color:var(--teamText,#166534);font-size:12px;font-weight:900;padding:3px;overflow-wrap:anywhere;border:1px solid color-mix(in srgb,var(--team,#22c55e) 35%, white)}.sticker.owned .code{box-shadow:inset 0 0 0 999px rgba(34,197,94,.12)}.sticker.duplicate .code{box-shadow:inset 0 0 0 999px rgba(245,158,11,.18);color:#9a6700}
.info{min-width:0}.name{font-weight:790;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sub{font-size:11px;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stepper{display:flex;align-items:center;gap:5px}.stepper button{width:35px;height:35px;border:1px solid #d0d5dd;background:#fff;border-radius:11px;font-size:21px;color:#344054}.stepper .qty{min-width:24px;text-align:center;font-weight:900;font-size:17px}.stepper .plus{border-color:#86efac;color:#166534;background:#f0fdf4}.pending .name::after{content:' · pendiente';color:#b42318;font-weight:700;font-size:12px}
.empty{text-align:center;color:var(--muted);padding:42px 10px}.hidden{display:none!important}.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(15px);background:#101828;color:white;padding:10px 14px;border-radius:999px;opacity:0;pointer-events:none;transition:.2s;z-index:30;font-size:13px;max-width:90%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.modal{position:fixed;inset:0;background:rgba(2,6,23,.55);display:flex;align-items:flex-end;z-index:20}.sheet{width:100%;max-width:840px;margin:0 auto;background:#fff;border-radius:24px 24px 0 0;padding:10px 16px calc(18px + env(safe-area-inset-bottom));max-height:88vh;overflow:auto}.grab{width:44px;height:5px;background:#d0d5dd;border-radius:99px;margin:2px auto 13px}.sheet h2{margin:4px 0 14px}.sheet p{color:var(--muted);font-size:14px}.sheet>button{width:100%;min-height:48px;border:1px solid var(--line);background:#fff;border-radius:12px;margin:5px 0;font-size:15px;font-weight:750;text-align:left;padding:0 14px}.sheet>button.danger{color:var(--red)}.sheet>button.ghost{text-align:center}.sheet textarea{width:100%;resize:vertical}.modalActions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.modalActions button{min-height:44px;padding:0 16px;border-radius:12px;border:1px solid var(--line);font-weight:800}.ghost{background:#fff;color:#344054}

.teamsPanel{padding:14px;margin-top:14px}.panelTitle{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}.panelTitle>div{display:flex;flex-direction:column}.panelTitle b{font-size:16px}.panelTitle span{font-size:11px;color:var(--muted);margin-top:2px}.miniBtn{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;padding:7px 10px;font-size:12px;font-weight:800}.teamGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.teamCard{border:1px solid var(--line);border-radius:15px;overflow:hidden;background:var(--card);box-shadow:0 3px 10px rgba(16,24,40,.05)}.teamCardTop{display:flex;align-items:center;gap:8px;padding:10px;color:#fff;background:linear-gradient(135deg,var(--c1),var(--c2))}.teamMiniCrest{width:34px;height:38px;flex:0 0 auto}.teamName{font-weight:850;font-size:12px;line-height:1.1;min-width:0;overflow:hidden;text-overflow:ellipsis}.teamProgressText{font-size:10px;opacity:.9;margin-top:3px}.teamBar{height:5px;background:rgba(255,255,255,.25);border-radius:99px;overflow:hidden;margin-top:5px}.teamBar>i{display:block;height:100%;background:#fff;border-radius:99px}.teamCardActions{display:grid;grid-template-columns:1fr 1fr}.teamCardActions button{border:0;background:transparent;color:var(--ink);padding:9px 5px;font-size:11px;font-weight:800}.teamCardActions button+button{border-left:1px solid var(--line)}.teamCardActions .missingBtn{color:#b42318}.teamGrid.hiddenGrid{display:none}.thumb{position:relative;overflow:hidden}.thumb svg{width:100%;height:100%;display:block}.thumb .initials{font-size:12px;font-weight:900}.sticker.flash{animation:flashCard .8s ease}@keyframes flashCard{0%,100%{transform:none}35%{transform:scale(1.01);box-shadow:0 0 0 3px rgba(34,197,94,.25)}}
@media(min-width:640px){.toolbar{grid-template-columns:1fr 250px 190px}.teamGrid{grid-template-columns:repeat(4,minmax(0,1fr))}.sticker{grid-template-columns:58px 76px 1fr auto}.code{font-size:13px}}
@media(prefers-color-scheme:dark){:root{--bg:#0f1720;--card:#151f2b;--ink:#f2f4f7;--muted:#98a2b3;--line:#2b3848}.quickRow input,.search,select,textarea{background:#101923;color:#f2f4f7;border-color:#344054}.tabs{background:#172330}.tabs button.active{background:#233142}.sticker .stepper button{background:#111a25;border-color:#344054;color:#f2f4f7}.sticker .stepper .plus{background:#163523;color:#86efac}.badge{background:#263443;color:#d0d5dd}.sheet{background:#151f2b}.sheet>button,.ghost{background:#111a25;color:#f2f4f7;border-color:#344054}.sectionBody{border-color:#344054}}
</style>
</head>
<body>
<header class="hero"><div class="brandRow"><div class="ball">⚽</div><div><div class="eyebrow">COLECCIÓN 2026–27</div><h1>Cromos Liga</h1></div><button id="moreBtn" class="iconBtn" aria-label="Más opciones">⋮</button></div><div class="progressWrap"><div class="progressText"><strong id="ownedCount">0</strong> / <span id="totalCount">593</span> cromos <span id="percent">0%</span></div><div class="progress"><div id="progressBar"></div></div><div class="miniStats"><span><b id="missingCount">593</b> faltan</span><span><b id="dupCount">0</b> repetidos</span><span><b id="copiesCount">0</b> copias</span></div></div></header>
<main>
<section class="quick card"><label for="quickInput">Entrada rápida</label><div class="quickRow"><input id="quickInput" autocomplete="off" placeholder="Ej. ALA 1, BAR 20, LY-O" /><button id="quickAdd" class="primary">Añadir</button></div><div class="hint">v1.4 · vista por equipos, miniaturas locales por cromo y acceso directo a faltantes de cada club. Todo funciona sin conexión.</div></section>
<section class="teamsPanel card"><div class="panelTitle"><div><b>Equipos</b><span>Progreso y acceso rápido</span></div><button id="toggleTeams" class="miniBtn">Ocultar</button></div><div id="teamGrid" class="teamGrid"></div></section>
<section class="toolbar"><input id="search" class="search" placeholder="Buscar por código, jugador o equipo…" /><select id="sectionFilter" aria-label="Sección"><option value="">Todas las secciones</option></select><select id="typeFilter" aria-label="Tipo"><option value="">Todos los tipos</option><option value="equipo">Equipos</option><option value="especial">Especiales</option><option value="extra">Extras</option></select></section>
<nav class="tabs" aria-label="Filtros"><button data-tab="all" class="active">Álbum</button><button data-tab="missing">Faltan</button><button data-tab="dups">Repetidos</button><button data-tab="owned">Tengo</button></nav>
<div id="list"></div><div id="empty" class="empty hidden">No hay cromos que coincidan con este filtro.</div></main>
<div id="toast" class="toast"></div>
<div id="menu" class="modal hidden"><div class="sheet"><div class="grab"></div><h2>Opciones</h2><button id="shareMissing">Compartir faltantes</button><button id="shareDups">Compartir repetidos</button><button id="exportMissingCsv">Exportar faltantes CSV</button><button id="exportDupsCsv">Exportar repetidos CSV</button><button id="shareBackup">Compartir copia de seguridad</button><button id="importBackup">Importar copia de seguridad</button><button id="resetAll" class="danger">Poner colección a cero</button><button id="closeMenu" class="ghost">Cerrar</button></div></div>
<div id="backupModal" class="modal hidden"><div class="sheet"><div class="grab"></div><h2>Importar copia</h2><p>Pega aquí el texto de una copia de seguridad creada por esta app.</p><textarea id="backupText" rows="8" placeholder='{"version":1,"quantities":{...}}'></textarea><div class="modalActions"><button id="cancelBackup" class="ghost">Cancelar</button><button id="applyBackup" class="primary">Importar</button></div></div></div>
<script>
'use strict';
const stickers=[{"id":"ALA 1","number":"1","name":"Escudo","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 2","number":"2","name":"Quique Sánchez Flores","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 3","number":"3","name":"Sivera","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 4","number":"4","name":"Pendiente","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 5","number":"5","name":"Jonny","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 6","number":"6","name":"Koski","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 7","number":"7","name":"Tenaglia","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 8","number":"8","name":"Parada","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 9","number":"9","name":"Yusi","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 10","number":"10","name":"Pendiente","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 11","number":"11","name":"Benavidez","section":"Deportivo Alavés","type":"equipo"},{"id":"ALA 12","number":"12","name":"Blanco","section":"Deportivo Al